msgstr "KI-Tools und Extras"

#. id 8a7ad178
#: index.html
msgid ""
"Claude AI integration for help with your own system, office software "
"installers, and the ISO tooling if you build your own."
msgstr ""
"Claude-KI-Integration für Hilfe bei deinem eigenen System, Installer für "
"Office-Software und die ISO-Werkzeuge, falls du selbst eine baust."

#. id 58d44d0c
#: index.html
msgid "AI Tools"
msgstr "KI-Tools"

#. id 6c3a72ea
#: index.html
msgid "Office"
msgstr "Office"

#. id 4f325d99
#: index.html
