#: usr/share/archlinux-tweak-tool/performance.py:2230
#, python-brace-format
msgid "MAKEFLAGS=-j{jobs} — {intent}"
msgstr "MAKEFLAGS=-j{jobs} : {intent}"

#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""
"\n"
"<b>{reserved} cœurs laissés libres</b>\n"
"<tt>-j{jobs}</tt> réserve {reserved} cœurs à l’environnement de bureau, afin "
"que l’interface et une\n"
"souris Bluetooth restent réactives pendant une longue compilation.\n"

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr "MAKEFLAGS mis à jour : -j{jobs}"

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""
"<b>Ce qui a changé</b>\n"
"<tt>{conf}</tt> définit maintenant <b>MAKEFLAGS=\\\"-j{jobs}\\\"</b>.\n"
"Ligne précédente :\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Pourquoi c’est important</b>\n"
"<tt>MAKEFLAGS</tt> contrôle le nombre de tâches parallèles que <tt>makepkg</"
"tt> utilise\n"
"lors de la compilation de paquets AUR ou depuis les sources. Arch fournit\n"
"<tt>#MAKEFLAGS=\\\"-j2\\\"</tt> en commentaire, la valeur par défaut est "
"donc\n"
"pratiquement monothread. Sur votre processeur à {ncores} cœurs, vous passez "
"ainsi\n"
"à côté de gains de vitesse importants : de nombreuses compilations AUR "
"passent de plusieurs minutes\n"
"à quelques secondes une fois les cœurs mobilisés.\n"
"{reserve_block}\n"
"<b>Comment revenir en arrière</b>\n"
"Une sauvegarde est conservée dans <tt>{backup}</tt>. Cliquez sur\n"
"<b>Restaurer la sauvegarde</b> sur cette page pour annuler à tout moment."

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr "Échec du réglage : consultez le journal d’ATT"

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr "Aucune sauvegarde dans /etc/makepkg.conf-bak : rien à restaurer."

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr "MAKEFLAGS restauré : retour à la valeur par défaut mono-thread d’Arch"

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr "MAKEFLAGS restauré depuis la sauvegarde"

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""
"<b>Ce qui a changé</b>\n"
"<tt>{conf}</tt> a été remplacé par le contenu de\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>Ce que cela signifie</b>\n"
"<tt>makepkg</tt> utilise désormais la valeur de <tt>MAKEFLAGS</tt> qui "
"figurait\n"
"dans la sauvegarde, généralement la valeur par défaut d’Arch en commentaire\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, qui revient à des compilations\n"
"mono-thread.\n"
"\n"
"<b>Comment réactiver les compilations parallèles</b>\n"
"Cliquez à tout moment sur <b>Optimiser pour tous les cœurs</b> sur cette "
"page."

