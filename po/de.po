#: usr/share/archlinux-tweak-tool/performance.py:2230
#, python-brace-format
msgid "MAKEFLAGS=-j{jobs} — {intent}"
msgstr "MAKEFLAGS=-j{jobs}: {intent}"

#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""
"\n"
"<b>{reserved} Kerne bleiben frei</b>\n"
"<tt>-j{jobs}</tt> lässt {reserved} Kerne für den Desktop übrig, damit die "
"Oberfläche und eine\n"
"Bluetooth-Maus reaktionsschnell bleiben, während ein langer Build läuft.\n"

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr "MAKEFLAGS aktualisiert: -j{jobs}"

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""
"<b>Was sich geändert hat</b>\n"
"<tt>{conf}</tt> setzt jetzt <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Vorherige Zeile:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Warum das wichtig ist</b>\n"
"<tt>MAKEFLAGS</tt> legt fest, wie viele parallele Jobs <tt>makepkg</tt> "
"beim\n"
"Bauen von AUR-Paketen oder beim Kompilieren aus dem Quellcode nutzt. Arch "
"liefert\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> auskommentiert aus, daher läuft standardmäßig\n"
"praktisch alles single-threaded. Bei deiner CPU mit {ncores} Kernen bleibt "
"dadurch\n"
"viel Leistung ungenutzt: Viele AUR-Builds verkürzen sich von Minuten\n"
"auf Sekunden, sobald die Kerne genutzt werden.\n"
"{reserve_block}\n"
"<b>So machst du es rückgängig</b>\n"
"Eine Sicherung liegt unter <tt>{backup}</tt>. Klicke auf\n"
"<b>Sicherung wiederherstellen</b> auf dieser Seite, um es jederzeit "
"rückgängig zu machen."

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr "Optimierung fehlgeschlagen: siehe ATT-Log"

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr ""
"Keine Sicherung unter /etc/makepkg.conf-bak: nichts wiederherzustellen."

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr ""
"MAKEFLAGS wiederhergestellt: zurück zum Single-Thread-Standard von Arch"

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr "MAKEFLAGS aus der Sicherung wiederhergestellt"

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""
"<b>Was sich geändert hat</b>\n"
"<tt>{conf}</tt> wurde durch den Inhalt von\n"
"<tt>{backup}</tt> ersetzt.\n"
"\n"
"<b>Was das bedeutet</b>\n"
"<tt>makepkg</tt> verwendet jetzt den <tt>MAKEFLAGS</tt>-Wert aus\n"
"der Sicherung, typischerweise den auskommentierten Arch-Standard\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, der auf Single-Thread-\n"
"Builds zurückfällt.\n"
"\n"
"<b>So aktivierst du parallele Builds wieder</b>\n"
"Klicke jederzeit auf <b>Für N Kerne optimieren</b> auf dieser Seite."

#: usr/share/archlinux-tweak-tool/performance.py:2326
msgid "Restore failed — see ATT log"
msgstr "Wiederherstellung fehlgeschlagen: siehe ATT-Log"

