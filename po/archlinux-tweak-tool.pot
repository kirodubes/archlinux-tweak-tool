msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2168
msgid "Restore /etc/makepkg.conf from /etc/makepkg.conf-bak"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2170
msgid "No backup file found at /etc/makepkg.conf-bak"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2188
msgid "Single core detected — parallel builds need ≥2 cores; no change made."
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2230
#, python-brace-format
msgid "MAKEFLAGS=-j{jobs} — {intent}"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr ""

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""

