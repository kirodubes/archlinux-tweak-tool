#, python-brace-format
msgid "MAKEFLAGS=-j{jobs} — {intent}"
msgstr "MAKEFLAGS=-j{jobs}: {intent}"

#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""
"\n"
"<b>{reserved} çekirdek boş bırakılıyor</b>\n"
"<tt>-j{jobs}</tt>, uzun bir derleme sürerken arayüzün ve bir\n"
"Bluetooth farenin duyarlı kalması için masaüstüne {reserved} çekirdek "
"bırakır.\n"

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr "MAKEFLAGS güncellendi: -j{jobs}"

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""
"<b>Ne değişti</b>\n"
"<tt>{conf}</tt> artık <b>MAKEFLAGS=\"-j{jobs}\"</b> olarak ayarlıyor.\n"
"Önceki satır:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Bu neden önemli</b>\n"
"<tt>MAKEFLAGS</tt>, <tt>makepkg</tt> programının AUR paketlerini derlerken\n"
"veya kaynaktan derleme yaparken kaç paralel iş kullanacağını belirler. "
"Arch,\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> satırını yorum satırı olarak sunar, bu yüzden "
"stok\n"
"varsayılan fiilen tek iş parçacıklıdır. {ncores} çekirdekli işlemcinizde "
"bu,\n"
"büyük bir hızı boşa harcamak demektir: birçok AUR derlemesi, çekirdekler\n"
"devreye girince dakikalardan saniyelere iner.\n"
"{reserve_block}\n"
"<b>Nasıl geri alınır</b>\n"
"<tt>{backup}</tt> konumunda bir yedek tutulur. İstediğiniz zaman geri almak "
"için\n"
"bu sayfadaki <b>Yedeği geri yükle</b> düğmesine tıklayın."

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr "Ayarlama başarısız oldu: ATT günlüğüne bakın"

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr ""
"/etc/makepkg.conf-bak konumunda yedek yok: geri yüklenecek bir şey yok."

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr ""
"MAKEFLAGS geri yüklendi: Arch'ın tek iş parçacıklı varsayılanına dönüldü"

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr "MAKEFLAGS yedekten geri yüklendi"

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""
"<b>Ne değişti</b>\n"
"<tt>{conf}</tt> dosyasının yerine\n"
"<tt>{backup}</tt> içeriği konuldu.\n"
"\n"
"<b>Bunun anlamı</b>\n"
"<tt>makepkg</tt> artık yedekteki <tt>MAKEFLAGS</tt> değerini kullanıyor:\n"
"genellikle Arch'ın yorum satırı olan varsayılanı\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, bu da tek iş parçacıklı\n"
"derlemelere döner.\n"
"\n"
"<b>Paralel derlemeler nasıl yeniden etkinleştirilir</b>\n"
"İstediğiniz zaman bu sayfadaki <b>N çekirdek için optimize et</b> düğmesine "
"tıklayın."

#: usr/share/archlinux-tweak-tool/performance.py:2326
