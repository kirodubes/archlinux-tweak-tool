msgstr "Elimina las herramientas y la configuración de instantáneas; las instantáneas ya creadas se conservan"

#: usr/share/archlinux-tweak-tool/btrfs_gui.py:215
msgid ""
"<i>This setup does not add a boot-menu snapshot picker. Rollback is done "
"from the\n"
"running system or the live ISO with snapper — Btrfs Assistant makes this "
"easy.\n"
"If you installed with GRUB you can add a picker yourself with grub-btrfs;\n"
"systemd-boot has no equivalent.</i>"
msgstr "<i>Esta configuración no añade un selector de instantáneas al menú de arranque. La reversión se hace desde el\nsistema en ejecución o desde la ISO en vivo con snapper; Btrfs Assistant lo facilita.\nSi instalaste con GRUB, puedes añadir un selector tú mismo con grub-btrfs;\nsystemd-boot no tiene nada equivalente.</i>"

