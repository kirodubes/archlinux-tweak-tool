#: usr/share/archlinux-tweak-tool/performance.py:2230
#, python-brace-format
msgid "MAKEFLAGS=-j{jobs} — {intent}"
msgstr "MAKEFLAGS=-j{jobs}: {intent}"

#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""
"\n"
"<b>Mantendo {reserved} núcleos livres</b>\n"
"<tt>-j{jobs}</tt> deixa {reserved} núcleos para o desktop, de modo que a "
"interface e um\n"
"mouse Bluetooth continuem responsivos durante uma compilação longa.\n"

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr "MAKEFLAGS atualizado: -j{jobs}"

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""
"<b>O que mudou</b>\n"
"<tt>{conf}</tt> agora define <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Linha anterior:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Por que isso importa</b>\n"
"O <tt>MAKEFLAGS</tt> controla quantos jobs paralelos o <tt>makepkg</tt> usa\n"
"ao construir pacotes do AUR ou compilar a partir do código-fonte. O Arch "
"traz\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> comentado, então o padrão original é\n"
"praticamente de thread única. Na sua CPU de {ncores} núcleos isso "
"desperdiça\n"
"muita velocidade: muitas builds do AUR caem de minutos\n"
"para segundos quando os núcleos são usados.\n"
"{reserve_block}\n"
"<b>Como reverter</b>\n"
"Um backup é mantido em <tt>{backup}</tt>. Clique em\n"
"<b>Restaurar backup</b> nesta página para desfazer a qualquer momento."

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr "O ajuste falhou: veja o log do ATT"

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr "Nenhum backup em /etc/makepkg.conf-bak: nada a restaurar."

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr "MAKEFLAGS restaurado: de volta ao padrão de thread única do Arch"

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr "MAKEFLAGS restaurado a partir do backup"

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""
"<b>O que mudou</b>\n"
"<tt>{conf}</tt> foi substituído pelo conteúdo de\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>O que isso significa</b>\n"
"O <tt>makepkg</tt> agora usa o valor de <tt>MAKEFLAGS</tt> que estava\n"
"no backup: normalmente o padrão comentado do Arch\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, que volta às builds\n"
"de thread única.\n"
"\n"
"<b>Como reativar as builds paralelas</b>\n"
"Clique em <b>Otimizar para N núcleos</b> nesta página a qualquer momento."

#: usr/share/archlinux-tweak-tool/performance.py:2326
