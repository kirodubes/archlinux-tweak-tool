#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""
"\n"
"<b>{reserved} core lasciati liberi</b>\n"
"<tt>-j{jobs}</tt> lascia {reserved} core al desktop, così l'interfaccia e "
"un\n"
"mouse Bluetooth restano reattivi mentre è in corso una build lunga.\n"

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr "MAKEFLAGS aggiornato: -j{jobs}"

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""
"<b>Cosa è cambiato</b>\n"
"<tt>{conf}</tt> ora imposta <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Riga precedente:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Perché è importante</b>\n"
"<tt>MAKEFLAGS</tt> controlla quanti job paralleli usa <tt>makepkg</tt>\n"
"quando compila pacchetti AUR o codice sorgente. Arch fornisce\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commentato, quindi il valore predefinito è\n"
"di fatto a thread singolo. Con la tua CPU da {ncores} core si rinuncia\n"
"a molta velocità: molte build AUR passano da minuti\n"
"a secondi una volta utilizzati tutti i core.\n"
"{reserve_block}\n"
"<b>Come ripristinare</b>\n"
"Un backup è conservato in <tt>{backup}</tt>. Fai clic su\n"
"<b>Ripristina backup</b> in questa pagina per annullare in qualsiasi momento."

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr "Ottimizzazione non riuscita: guarda il log di ATT"

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr "Nessun backup in /etc/makepkg.conf-bak: niente da ripristinare."

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr ""
"MAKEFLAGS ripristinato: ora è tornato al valore predefinito di Arch, a "
"thread singolo"

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr "MAKEFLAGS ripristinato dal backup"

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""
"<b>Cosa è cambiato</b>\n"
"<tt>{conf}</tt> è stato sostituito con il contenuto di\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>Cosa significa</b>\n"
"<tt>makepkg</tt> ora usa il valore di <tt>MAKEFLAGS</tt> presente\n"
"nel backup, in genere il valore predefinito commentato di Arch\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, che ripiega su build\n"
"a thread singolo.\n"
"\n"
"<b>Come riabilitare le build parallele</b>\n"
"Clicca su <b>Ottimizza per N core</b> in questa pagina in qualsiasi momento."

#: usr/share/archlinux-tweak-tool/performance.py:2326
