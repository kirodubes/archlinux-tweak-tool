#: usr/share/archlinux-tweak-tool/btrfs_gui.py:215
msgid ""
"<i>This setup does not add a boot-menu snapshot picker. Rollback is done "
"from the\n"
"running system or the live ISO with snapper — Btrfs Assistant makes this "
"easy.\n"
"If you installed with GRUB you can add a picker yourself with grub-btrfs;\n"
"systemd-boot has no equivalent.</i>"
msgstr ""
