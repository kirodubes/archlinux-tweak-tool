#: usr/share/archlinux-tweak-tool/network_gui.py:340
msgid "<b>Firewall</b>"
msgstr "<b>Firewall</b>"

#: usr/share/archlinux-tweak-tool/network_gui.py:352
#: usr/share/archlinux-tweak-tool/services.py:807
msgid ""
"Firewall (firewalld) is <b>active</b> — Kiro enables it by default to keep "
"you protected."
msgstr ""
"Il firewall (firewalld) è <b>attivo</b>: Kiro lo abilita per impostazione "
"predefinita per tenerti protetto."

#: usr/share/archlinux-tweak-tool/network_gui.py:354
#: usr/share/archlinux-tweak-tool/services.py:809
msgid "Firewall (firewalld) is <b>inactive</b>."
msgstr "Il firewall (firewalld) è <b>inattivo</b>."

