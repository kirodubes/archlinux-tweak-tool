#: usr/share/archlinux-tweak-tool/performance.py:2230
#, python-brace-format
msgid "MAKEFLAGS=-j{jobs} — {intent}"
msgstr "MAKEFLAGS=-j{jobs}: {intent}"

#: usr/share/archlinux-tweak-tool/performance.py:2234
#, python-brace-format
msgid ""
"\n"
"<b>Keeping {reserved} cores free</b>\n"
"<tt>-j{jobs}</tt> leaves {reserved} cores for the desktop, so the UI and a\n"
"Bluetooth mouse stay responsive while a long build runs.\n"
msgstr ""
"\n"
"<b>{reserved} mag szabadon marad</b>\n"
"A <tt>-j{jobs}</tt> {reserved} magot meghagy az asztalnak, így a felület és "
"egy\n"
"Bluetooth-egér akkor is reagál, amíg egy hosszú építés fut.\n"

#: usr/share/archlinux-tweak-tool/performance.py:2243
#, python-brace-format
msgid "MAKEFLAGS updated — -j{jobs}"
msgstr "MAKEFLAGS frissítve: -j{jobs}"

#: usr/share/archlinux-tweak-tool/performance.py:2245
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> now sets <b>MAKEFLAGS=\"-j{jobs}\"</b>.\n"
"Previous line:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Why this matters</b>\n"
"<tt>MAKEFLAGS</tt> controls how many parallel jobs <tt>makepkg</tt> uses\n"
"when building AUR packages or compiling from source. Arch ships\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> commented out, so the stock default is\n"
"effectively single-threaded. On your {ncores}-core CPU this leaves\n"
"a lot of speed on the table — many AUR builds drop from minutes\n"
"to seconds once the cores are engaged.\n"
"{reserve_block}\n"
"<b>How to revert</b>\n"
"A backup is kept at <tt>{backup}</tt>. Click\n"
"<b>Restore backup</b> on this page to undo at any time."
msgstr ""
"<b>Mi változott</b>\n"
"A(z) <tt>{conf}</tt> mostantól a <b>MAKEFLAGS=\"-j{jobs}\"</b> értéket "
"állítja be.\n"
"Előző sor:\n"
"<tt>{before}</tt>\n"
"\n"
"<b>Miért fontos</b>\n"
"A <tt>MAKEFLAGS</tt> azt szabályozza, hány párhuzamos feladatot használ a "
"<tt>makepkg</tt>,\n"
"ha AUR-csomagokat épít vagy forrásból fordít. Az Arch a\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt> sort kikommentezve szállítja, így az "
"alapértelmezés\n"
"gyakorlatilag egyszálú. A te {ncores} magos processzorodon ez sok\n"
"sebességet veszni hagy: sok AUR-építés percekről\n"
"másodpercekre rövidül, ha a magok munkába állnak.\n"
"{reserve_block}\n"
"<b>Hogyan vonhatod vissza</b>\n"
"A mentés itt található: <tt>{backup}</tt>. Kattints a\n"
"<b>Mentés visszaállítása</b> gombra ezen az oldalon, hogy bármikor "
"visszavond."

#: usr/share/archlinux-tweak-tool/performance.py:2274
msgid "Tune failed — see ATT log"
msgstr "A hangolás sikertelen: lásd az ATT naplót"

#: usr/share/archlinux-tweak-tool/performance.py:2286
msgid "No backup at /etc/makepkg.conf-bak — nothing to restore."
msgstr "Nincs mentés itt: /etc/makepkg.conf-bak, nincs mit visszaállítani."

#: usr/share/archlinux-tweak-tool/performance.py:2303
msgid "MAKEFLAGS restored — back to Arch's single-threaded default"
msgstr "MAKEFLAGS visszaállítva: vissza az Arch egyszálú alapértelmezésére"

#: usr/share/archlinux-tweak-tool/performance.py:2307
msgid "MAKEFLAGS restored from backup"
msgstr "MAKEFLAGS visszaállítva a mentésből"

#: usr/share/archlinux-tweak-tool/performance.py:2309
#, python-brace-format
msgid ""
"<b>What changed</b>\n"
"<tt>{conf}</tt> has been replaced with the contents of\n"
"<tt>{backup}</tt>.\n"
"\n"
"<b>What this means</b>\n"
"<tt>makepkg</tt> now uses whatever <tt>MAKEFLAGS</tt> value was in\n"
"the backup — typically Arch's commented default\n"
"<tt>#MAKEFLAGS=\"-j2\"</tt>, which falls back to single-threaded\n"
"builds.\n"
"\n"
"<b>How to re-enable parallel builds</b>\n"
"Click <b>Optimize for N cores</b> on this page at any time."
msgstr ""
"<b>Mi változott</b>\n"
"A(z) <tt>{conf}</tt> tartalma lecserélődött a(z)\n"
"<tt>{backup}</tt> tartalmára.\n"
"\n"
"<b>Mit jelent ez</b>\n"
"A <tt>makepkg</tt> mostantól a mentésben szereplő <tt>MAKEFLAGS</tt>\n"
"értéket használja: jellemzően az Arch kikommentezett alapértelmezését,\n"
"a <tt>#MAKEFLAGS=\"-j2\"</tt> sort, ami egyszálú\n"
"építésre esik vissza.\n"
"\n"
"<b>Hogyan engedélyezheted újra a párhuzamos építést</b>\n"
"Kattints bármikor az <b>Optimalizálás N magra</b> gombra ezen az oldalon."

