msgstr "<b>Брандмауэр</b>"

#: usr/share/archlinux-tweak-tool/network_gui.py:361
#: usr/share/archlinux-tweak-tool/services.py:799
msgid ""
"Firewall (firewalld) is <b>active</b> — Kiro enables it by default to keep "
"you protected."
msgstr ""
"Брандмауэр (firewalld) <b>активен</b>: Kiro включает его по умолчанию для "
"вашей защиты."

#: usr/share/archlinux-tweak-tool/network_gui.py:363
#: usr/share/archlinux-tweak-tool/services.py:801
