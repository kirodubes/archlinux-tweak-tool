[codespell]
# ans = shell variable in the plymouth strip scripts; browseable = the Samba smb.conf option name; noice = a widget name in desktopr_gui.py; zink = Mesa's Zink GL driver
# The desktop entry carries the translated menu texts (non-English words).
ignore-words-list = ans,browseable,noice,zink
skip = *.po,*.pot,*.desktop
